    "/api/v1/spaces/{space}/documents": {
      "post": {
        "tags": [],
        "summary": "Adds a file as a new document – the bytes as the body, its media type as `Content-Type`. The same bytes twice\nin a space are one document.",
        "operationId": "add_document",
        "parameters": [
          {
            "name": "space",
            "in": "path",
            "description": "the space",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "The name the file came with.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "the file",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "the same bytes were there already",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedView"
                }
              }
            }
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedView"
                }
              }
            }
          },
          "403": {
